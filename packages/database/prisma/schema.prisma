// DePaso — schema de base de datos.
// Fuente: master prompt sección 70 (lista mínima de entidades) + docs/development/DATABASE.md.
// Alcance de lanzamiento: sólo Mar del Plata (sección 42) — no se modela jerarquía
// geográfica más allá de `city` en StoreBranch, para no sobre-diseñar antes de expandir.

generator client {
  provider      = "prisma-client-js"
  // Motor nativo (local) y el de Linux para el contenedor de EasyPanel.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlaceType {
  HOME
  WORK
  STUDY
  GYM
  FAMILY
  CUSTOM
}

/// Rol de cuenta — sección "Autorización: RBAC" de docs/legal-functional/LEGAL.md (p.15/97).
/// Sólo distingue USER/ADMIN; el detalle fino de RBAC ("soporte no ve ubicaciones por
/// defecto") queda NO DEFINIDO hasta que exista un rol de soporte real (Fase 20+).
enum Role {
  USER
  MERCHANT
  ADMIN
}

/// Solicitud de un usuario común para pasar a rol MERCHANT; la resuelve un ADMIN.
enum MerchantRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductPreferenceType {
  EXACT
  PREFERRED
  ANY
}

enum StorePreferenceType {
  REQUIRED
  PREFERRED
}

/// `OFFICIAL`/`STORE`/`COMMUNITY`/`ESTIMATED` son los valores originales (Fase 1). Los
/// agregados de abajo son de la ingestión SEPA real (docs/data/SEPA.md) — se agregan en
/// vez de renombrar para no romper datos ya cargados (Fase 12, carga manual admin).
enum PriceSourceType {
  OFFICIAL
  STORE
  COMMUNITY
  ESTIMATED
  /// Sistema Electrónico de Publicidad de Precios Argentinos — fuente oficial primaria.
  OFFICIAL_SEPA
  RETAILER_ONLINE
  RECEIPT
  MANUAL_ADMIN
  /// Precio cargado por el dueño del comercio (rol MERCHANT).
  MERCHANT
}

/// Fuente de un `DataImportRun` — hoy sólo SEPA; separado de `PriceSourceType` porque un
/// import puede fallar sin haber escrito ningún `Price` todavía.
enum ImportSourceType {
  SEPA_MINORISTA
  SEPA_MAYORISTA
}

enum ImportRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

/// Sección 68: no perder históricos de una sucursal cerrada — nunca se borra, sólo cambia
/// de estado.
enum StoreBranchStatus {
  ACTIVE
  POSSIBLY_INACTIVE
  INACTIVE
  CLOSED
}

/// Estados de confianza del precio — docs/legal-functional/BUSINESS-RULES.md (p.6):
/// Informado / Confirmado / Discutido / En revisión / Vencido.
enum PriceStatus {
  VERIFIED
  COMMUNITY_CONFIRMED
  DISPUTED
  IN_REVIEW
  STALE
  LOW_CONFIDENCE
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum OptimizationMode {
  BALANCED
  CHEAPEST
  FASTEST
}

enum TransportMode {
  CAR
  MOTORCYCLE
  BICYCLE
  WALK
  PUBLIC_TRANSPORT
}

enum ConsentType {
  TERMS
  PRIVACY
  LOCATION
  MARKETING
}

enum ModerationEventType {
  REPORT_HIDDEN
  REPORT_WEIGHTED_DOWN
  REPORT_REJECTED
  USER_SUSPENDED
  USER_APPEALED
  PRICE_SENT_TO_REVIEW
}

enum PlanLabel {
  BALANCED
  FASTEST
  CHEAPEST
}

// ---------------------------------------------------------------------------
// Cuenta, consentimiento, privacidad
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  /// Ver enum `Role` — MFA para ADMIN es un requisito legal pendiente (LEGAL.md p.97,
  /// NO DEFINIDO todavía qué proveedor de MFA usar), documentado como brecha conocida en
  /// DECISIONS.md en vez de simularlo.
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Borrado lógico — retención según docs/legal-functional/LEGAL.md (p.15).
  deletedAt    DateTime?

  profile             UserProfile?
  consents            UserConsent[]
  sessions             Session[]
  places               UserPlace[]
  shoppingLists        ShoppingList[]
  productPreferences   ProductPreference[]
  storePreferences     StorePreference[]
  savedRouteContexts   SavedRouteContext[]
  optimizationRuns     OptimizationRun[]
  priceReports         PriceReport[]
  trustScore           UserTrustScore?
  merchantRequests     MerchantRequest[] @relation("MerchantRequestApplicant")
  reviewedMerchantRequests MerchantRequest[] @relation("MerchantRequestReviewer")
  ownedBranches        StoreBranch[]
  listMemberships      ShoppingListMember[]
  announcements        Announcement[]
  paymentMethods       UserPaymentMethod[]

  @@map("users")
}

model MerchantRequest {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation("MerchantRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)
  businessName    String @db.VarChar(255)
  address         String @db.VarChar(255)
  phone           String?
  /// Correo de contacto obligatorio: el equipo de DePaso se comunica por acá o por teléfono para
  /// confirmar que la persona realmente trabaja en el comercio antes de aprobar.
  contactEmail    String?
  note            String? @db.Text
  latitude        Float
  longitude       Float
  /// Cuándo y quién confirmó el vínculo con el comercio (llamada o correo) al aprobar.
  contactVerifiedAt DateTime?
  contactVerifiedBy String?
  /// Sucursal que ya existe en DePaso (importada de SEPA) y el comercio pide administrar.
  /// `null` = comercio nuevo: al aprobar se crea su propia sucursal.
  storeBranchId   String?
  storeBranch     StoreBranch?          @relation(fields: [storeBranchId], references: [id])
  status          MerchantRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?                 @relation("MerchantRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String? @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([storeBranchId])
  @@map("merchant_requests")
}

model UserProfile {
  userId            String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Declaración de edad (sección 61 del master prompt) — sin verificación adicional en el MVP.
  ageConfirmed18Plus Boolean @default(false)
  marketingOptIn     Boolean @default(false)

  @@map("user_profiles")
}

/// Evidencia de aceptación de T&C/Privacidad/Ubicación/Marketing — requisito de
/// trazabilidad obligatorio (docs/legal-functional/FUNCTIONAL.md).
model UserConsent {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            ConsentType
  documentVersion String
  accepted        Boolean
  acceptedAt      DateTime    @default(now())

  @@index([userId, type])
  @@map("user_consents")
}

/// Sesión de auth propia (docs/development/DECISIONS.md, 2026-09-11 — auth sobre Prisma,
/// no Supabase). Se guarda el hash del token, no el token en texto plano — un dump de la
/// tabla no alcanza para robar sesiones activas. "Sesión persistente" (sección 10 del
/// master prompt); TTL de 30 días es elección MVP, no definida en la documentación.
model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Lugares del usuario
// ---------------------------------------------------------------------------

model UserPlace {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String @db.VarChar(255)
  type       PlaceType
  address    String @db.VarChar(255)
  latitude   Float
  longitude  Float
  isFavorite Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  routeStops SavedRouteStop[]

  @@index([userId])
  @@map("user_places")
}

model SavedRouteContext {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  /// Paradas completas en orden (origen, paradas, destino).
  stops SavedRouteStop[]

  @@index([userId])
  @@map("saved_route_contexts")
}

/// Una parada de un recorrido guardado. Se guarda completa (nombre, dirección y coordenadas)
/// para poder incluir puntos de hoy, de la ubicación actual o elegidos en el mapa; `placeId`
/// sólo se completa si la parada es un lugar guardado del usuario.
model SavedRouteStop {
  contextId String
  context   SavedRouteContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  position  Int
  name      String            @db.VarChar(255)
  address   String            @db.VarChar(255)
  latitude  Float
  longitude Float
  emoji     String            @db.VarChar(16)
  placeId   String?
  place     UserPlace?        @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@id([contextId, position])
  @@index([placeId])
  @@map("saved_route_stops")
}

// ---------------------------------------------------------------------------
// Catálogo: marca, producto, variante, alias
// ---------------------------------------------------------------------------

/// Logo de una cadena o marca de comercios (Coto, Shell…). La imagen vive en la base: la app la
/// pide una vez y la reparte sin depender de sitios externos. Se carga con `db:brand-logos`.
model BrandLogo {
  slug      String   @id @db.VarChar(40)
  name      String   @db.VarChar(80)
  mimeType  String   @db.VarChar(40)
  image     Bytes    @db.MediumBlob
  updatedAt DateTime @updatedAt
  aliases   BrandLogoAlias[]

  @@map("brand_logos")
}

/// Nombres con los que se reconoce la cadena ("la anonima", "chango mas"): ya normalizados
/// (minúscula, sin tildes). Una fila por alias para no guardar listas en una columna (3FN).
model BrandLogoAlias {
  brandSlug String   @db.VarChar(40)
  alias     String   @db.VarChar(80)
  brand     BrandLogo @relation(fields: [brandSlug], references: [slug], onDelete: Cascade)

  @@id([brandSlug, alias])
  @@map("brand_logo_aliases")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Product {
  id       String    @id @default(uuid())
  brandId  String?
  brand    Brand?    @relation(fields: [brandId], references: [id])
  name     String @db.VarChar(255)
  /// Sección 8 — nombre normalizado (lowercase, sin acentos, espacios colapsados) para
  /// matching tolerante a variaciones sin depender sólo de EAN.
  normalizedName String? @db.VarChar(255)
  category String
  /// Foto frontal (Open Food Facts, resuelta por EAN a demanda desde la búsqueda). `null` +
  /// `imageCheckedAt` seteado = ya se buscó y no hay foto; no se vuelve a pedir por un tiempo.
  imageUrl       String? @db.Text
  imageCheckedAt DateTime?
  /// Tipo derivado del nombre ("gaseosa", "vino"…), ver `classifyProductType` en @depaso/domain.
  /// `null` = no se reconoció; el producto se sigue encontrando por texto.
  productType    String?
  /// Cuántos precios vigentes tiene el producto en todos los comercios. Se guarda precalculado
  /// (ver `refreshProductPopularity`) porque contarlo al buscar tardaba ~1,5 s por consulta.
  popularity     Int      @default(0)
  variants ProductVariant[]
  preferences ProductPreference[]

  @@index([category])
  @@index([normalizedName])
  @@index([productType])
  @@index([productType, popularity(sort: Desc)])
  @@map("products")
  planMisses OptimizationPlanMissingProduct[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String @db.VarChar(255)
  ean       String?  @unique
  /// `true` sólo si `ean` pasó la validación de checksum GTIN (8/12/13/14 dígitos) — el
  /// campo `productos_ean` de SEPA repite el mismo valor de `id_producto` sin indicar si es
  /// un EAN real o un código interno del comercio (corrección al supuesto original,
  /// docs/data/SEPA.md); no confiar en el nombre del campo, validar el dígito verificador.
  eanConfirmed Boolean @default(false)
  unit      String
  unitSize  Float

  aliases ProductAlias[]
  prices  Price[]

  @@index([productId])
  @@map("product_variants")
}

/// Soporta búsqueda tolerante a variaciones ("coca", "coca cola", "coca 2 litros") — sección 37.
model ProductAlias {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  alias            String @db.VarChar(255)

  @@index([alias])
  @@map("product_aliases")
}

// ---------------------------------------------------------------------------
// Comercios y sucursales
// ---------------------------------------------------------------------------

/// Razón social/CUIT (docs/data/SEPA.md) — separado de `Store` (la "bandera" comercial:
/// Vea/Disco/Jumbo son 3 `Store` bajo 1 `StoreCompany` "Cencosud S.A.", confirmado contra
/// el feed real de SEPA). `Store` no se renombra a evitar romper la Fase 11 (admin CRUD ya
/// construido) — esto es una extensión aditiva, `companyId` nullable.
model StoreCompany {
  id              String         @id @default(uuid())
  cuit            String         @unique
  legalName       String @db.VarChar(255)
  source          ImportSourceType?
  sourceUpdatedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  brands Store[]

  @@map("store_companies")
}

model Store {
  id      String        @id @default(uuid())
  name    String @db.VarChar(255)
  /// Nullable — las `Store` cargadas a mano (Fase 11, antes de esta migración) no tienen
  /// empresa asociada todavía.
  companyId String?
  company   StoreCompany? @relation(fields: [companyId], references: [id])
  /// `id_bandera` de SEPA — junto con `companyId` identifica una bandera de forma estable
  /// entre corridas de import (sección 24, "nunca requerir deploy para un comercio nuevo").
  externalSepaBrandId String?
  normalizedName      String? @db.VarChar(255)

  branches StoreBranch[]
  aliases  StoreAlias[]

  @@unique([companyId, externalSepaBrandId])
  @@map("stores")
}

/// Ejemplo: "Carrefour Market" / "Market Carrefour" / "Carrefour" deben resolver a la misma
/// `Store` (sección 24).
model StoreAlias {
  id              String @id @default(uuid())
  storeId         String
  store           Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  alias           String @db.VarChar(255)
  normalizedAlias String @db.VarChar(255)

  @@index([normalizedAlias])
  @@map("store_aliases")
}

model StoreBranch {
  id        String  @id @default(uuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String @db.VarChar(255)
  address   String @db.VarChar(255)
  latitude  Float
  longitude Float

  /// IDs de SEPA (sección 5) — la terna identifica una sucursal de forma estable entre
  /// corridas de import. Nullable: sucursales cargadas a mano no tienen estos IDs.
  externalSepaCommerceId String?
  externalSepaBrandId    String?
  externalSepaBranchId   String?
  street                 String?
  streetNumber           String?
  postalCode             String?
  source                 ImportSourceType?
  sourceUpdatedAt        DateTime?
  /// Sección 68 — nunca se borra una sucursal por no aparecer en un import; se marca.
  status                 StoreBranchStatus @default(ACTIVE)
  marketRegionId         String?
  marketRegion           MarketRegion?     @relation(fields: [marketRegionId], references: [id])
  /// Usuario MERCHANT dueño de la sucursal (null para sucursales importadas o cargadas por admin).
  ownerUserId            String?
  owner                  User?             @relation(fields: [ownerUserId], references: [id])
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt

  /// Ciudad y provincia salen de `marketRegion` (no se repiten acá).
  hours              StoreBranchHours[]
  prices             Price[]
  priceReports       PriceReport[]
  storePreferences   StorePreference[]
  optimizationStops  OptimizationPlanStop[]
  dataIssues         BranchDataIssue[]
  merchantRequests   MerchantRequest[]

  @@unique([externalSepaCommerceId, externalSepaBrandId, externalSepaBranchId])
  @@index([storeId])
  @@index([marketRegionId])
  @@index([ownerUserId])
  @@map("store_branches")
}

/// Horario de una sucursal por día, tal como lo publica SEPA (ej. día "lunes", "08:00 a 21:30").
model StoreBranchHours {
  branchId String
  branch   StoreBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  day      String      @db.VarChar(16)
  hours    String      @db.VarChar(64)

  @@id([branchId, day])
  @@map("store_branch_hours")
}

/// Sección 43 — SEPA vs. locator oficial no coinciden: registrar, nunca pisar en silencio.
model BranchDataIssue {
  id            String      @id @default(uuid())
  storeBranchId String
  storeBranch   StoreBranch @relation(fields: [storeBranchId], references: [id], onDelete: Cascade)
  type          String
  detail        String @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([storeBranchId])
  @@map("branch_data_issues")
}

/// Scope geográfico como configuración, no `if city === "Mar del Plata"` (sección 62).
/// Permite agregar otra región (Fase futura, sección 63) sin migrar el schema de nuevo.
model MarketRegion {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  province        String
  country         String   @default("Argentina")
  enabled         Boolean  @default(true)
  minLatitude     Float
  maxLatitude     Float
  minLongitude    Float
  maxLongitude    Float

  branches   StoreBranch[]
  /// Variantes de `sucursales_localidad` que cuentan como "dentro" de la región (sección 15).
  localities MarketRegionLocality[]

  @@map("market_regions")
}

/// Una variante de nombre de localidad que SEPA trae para la región ("MAR DEL PLATA", etc.).
model MarketRegionLocality {
  regionId String
  region   MarketRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  alias    String       @db.VarChar(120)

  @@id([regionId, alias])
  @@map("market_region_localities")
}

// ---------------------------------------------------------------------------
// Precios y comunidad
// ---------------------------------------------------------------------------

model Price {
  id               String          @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  storeBranchId    String
  storeBranch      StoreBranch     @relation(fields: [storeBranchId], references: [id], onDelete: Cascade)
  price            Decimal         @db.Decimal(12, 2)
  /// Promociones tal como las publica la fuente (sección 9) — nunca se aplican solas sin
  /// validar sus condiciones (BUSINESS-RULES.md p.10); se muestran como alternativa.
  promoPrice1       Decimal?        @db.Decimal(12, 2)
  promoDescription1 String? @db.Text
  promoPrice2       Decimal?        @db.Decimal(12, 2)
  promoDescription2 String? @db.Text
  currency         String          @default("ARS")
  sourceType       PriceSourceType
  sourceReference  String?
  /// Clave externa de la fuente (ej. `id_comercio|id_bandera|id_sucursal|id_producto` de
  /// SEPA) — permite que el import job identifique "ya vi esta observación" sin depender
  /// sólo de `productVariantId`+`storeBranchId` (que puede matchear de forma aproximada).
  sourceExternalId String?
  /// Cómo lo llama el comercio en su góndola ("Leche entera La Serenísima 1 L"). Sólo para esta
  /// sucursal: el nombre del catálogo no cambia para los demás comercios.
  displayName      String? @db.VarChar(255)
  reportedAt       DateTime        @default(now())
  validFrom        DateTime        @default(now())
  confidence       ConfidenceLevel
  status           PriceStatus     @default(VERIFIED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  history PriceHistory[]

  @@index([productVariantId, storeBranchId])
  @@index([sourceExternalId])
  @@map("prices")
}

/// Nunca se sobreescribe sin histórico (regla obligatoria, BUSINESS-RULES.md p.7).
model PriceHistory {
  id               String      @id @default(uuid())
  priceId          String
  price            Price       @relation(fields: [priceId], references: [id], onDelete: Cascade)
  amount           Decimal     @db.Decimal(12, 2)
  status           PriceStatus
  changedAt        DateTime    @default(now())
  changeReason     String @db.VarChar(255)

  @@index([priceId])
  @@map("price_history")
}

model PriceReport {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariantId  String
  storeBranchId     String
  storeBranch       StoreBranch @relation(fields: [storeBranchId], references: [id], onDelete: Cascade)
  reportedPrice     Decimal     @db.Decimal(12, 2)
  requiresPromotion Boolean     @default(false)
  promotionNote     String? @db.Text
  photoEvidenceUrl  String? @db.Text
  goodFaithDeclared Boolean     @default(false)
  createdAt         DateTime    @default(now())

  moderationEvents CommunityModerationEvent[]

  @@index([productVariantId, storeBranchId, createdAt])
  @@map("price_reports")
}

model UserTrustScore {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nunca se expone públicamente el valor exacto (BUSINESS-RULES.md p.7).
  score              Float    @default(0.5)
  reportsSubmitted   Int      @default(0)
  reportsConfirmed   Int      @default(0)
  lastUpdatedAt      DateTime @updatedAt

  @@map("user_trust_scores")
}

model CommunityModerationEvent {
  id                  String              @id @default(uuid())
  type                ModerationEventType
  targetPriceReportId String?
  targetPriceReport   PriceReport?        @relation(fields: [targetPriceReportId], references: [id])
  targetUserId        String?
  reason              String @db.Text
  createdAt           DateTime            @default(now())
  createdByAdminId    String?

  @@index([targetPriceReportId])
  @@map("community_moderation_events")
}

// ---------------------------------------------------------------------------
// Ingestión de datos (SEPA) — docs/data/SEPA.md, docs/data/IMPORT-PIPELINE.md
// ---------------------------------------------------------------------------

/// Sección 28 — idempotencia: un mismo recurso (`resourceId` de CKAN) no se reimporta dos
/// veces. `fileHash` detecta si el contenido cambió aunque el recurso "rote" de URL.
model DataImportRun {
  id                   String           @id @default(uuid())
  source               ImportSourceType
  resourceId           String
  resourceLastModified DateTime
  fileHash             String
  startedAt            DateTime         @default(now())
  completedAt          DateTime?
  status               ImportRunStatus  @default(RUNNING)
  rowsRead             Int              @default(0)
  rowsAccepted         Int              @default(0)
  rowsRejected         Int              @default(0)
  branchesDetected     Int              @default(0)
  error                String? @db.Text

  anomalies ImportAnomaly[]

  /// Por `fileHash`, no por `resourceId`: CKAN reusa el mismo `resourceId` para el mismo
  /// slot de día de la semana (confirmado real — "Domingo" tiene el mismo id cada semana,
  /// sólo cambia el contenido) — un unique por `resourceId` bloquearía reimportar la
  /// semana siguiente. `fileHash` es lo que realmente identifica "ya importé este
  /// contenido" (sección 28).
  @@unique([source, fileHash])
  @@index([source, resourceId])
  @@map("data_import_runs")
}

/// Sección 29-30 — nunca borrar silenciosamente una fila con datos sospechosos; queda acá
/// para revisión manual. `needsReview` distingue "rechazado" de "aceptado pero raro"
/// (ej. una baja de precio extrema que puede ser una promo real, sección 30).
model ImportAnomaly {
  id          String        @id @default(uuid())
  importRunId String
  importRun   DataImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  type        String
  rawRow      String @db.Text
  reason      String @db.Text
  needsReview Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([importRunId])
  @@map("import_anomalies")
}

// ---------------------------------------------------------------------------
// Listas y preferencias
// ---------------------------------------------------------------------------

model ShoppingList {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String @db.VarChar(255)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items            ShoppingListItem[]
  optimizationRuns OptimizationRun[]
  members          ShoppingListMember[]

  @@index([userId])
  @@map("shopping_lists")
}

/// Usuario con quien el dueño compartió la lista. Puede ver la lista y agregar, editar y
/// quitar productos; sólo el dueño la renombra, archiva, borra o cambia con quién se comparte.
model ShoppingListMember {
  id             String       @id @default(uuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([shoppingListId, userId])
  @@index([userId])
  @@map("shopping_list_members")
}

/// Novedad que publica un administrador y ven todos los usuarios en Actividad > Novedades
/// (actualizaciones de la app, avisos de promociones, mantenimiento, etc.).
model Announcement {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(120)
  body      String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Se puede ocultar sin borrarla.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt(sort: Desc)])
  @@map("announcements")
}

/// Medio de pago que el usuario declara tener (slug del catálogo `PAYMENT_METHODS` de
/// `@depaso/domain`, ej. "cuenta-dni"). Sirve para aplicar sólo las promos que le corresponden.
model UserPaymentMethod {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  methodSlug String
  createdAt  DateTime @default(now())

  @@unique([userId, methodSlug])
  @@map("user_payment_methods")
}

/// Promoción de banco/billetera en un comercio. Se sincroniza desde un dataset abierto
/// (`packages/database/scripts` / `/api/cron/sync-promos`) — es informativa: las condiciones
/// reales las define el comercio y el emisor, por eso siempre se muestra con su aviso.
model PaymentPromo {
  id              String   @id @default(uuid())
  /// Id de la fuente — permite re-sincronizar sin duplicar.
  externalId      String   @unique
  retailer        String @db.VarChar(255)
  /// Nombre normalizado del comercio, para matchear contra `Store.normalizedName`/`name`.
  normalizedRetailer String @db.VarChar(255)
  bank            String?
  discountPercent Float
  /// Tope de reintegro en ARS por compra/día (null = sin tope informado).
  capAmount       Float?
  validityNote    String? @db.Text
  sourceUrl       String? @db.Text
  source          String?
  active          Boolean  @default(true)
  syncedAt        DateTime @default(now())

  /// Medios de pago de la promo; sin filas = promo general (sin medio específico).
  methods         PaymentPromoMethod[]
  /// Días en que rige; sin filas = todos los días.
  days            PaymentPromoDay[]

  @@index([normalizedRetailer])
  @@map("payment_promos")
}

/// Un medio de pago (slug del catálogo `PAYMENT_METHODS`) al que aplica la promo.
model PaymentPromoMethod {
  promoId    String
  promo      PaymentPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  methodSlug String       @db.VarChar(64)

  @@id([promoId, methodSlug])
  @@map("payment_promo_methods")
}

/// Un día de la semana en que rige la promo: 0 = domingo … 6 = sábado.
model PaymentPromoDay {
  promoId   String
  promo     PaymentPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  dayOfWeek Int

  @@id([promoId, dayOfWeek])
  @@map("payment_promo_days")
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  productId      String
  quantity       Int          @default(1)
  note           String? @db.Text

  @@index([shoppingListId])
  @@map("shopping_list_items")
}

model ProductPreference {
  id               String                @id @default(uuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             ProductPreferenceType
  preferredBrandId String?

  @@unique([userId, productId])
  @@map("product_preferences")
}

model StorePreference {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  type          StorePreferenceType
  storeBranchId String
  storeBranch   StoreBranch         @relation(fields: [storeBranchId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("store_preferences")
}

// ---------------------------------------------------------------------------
// Optimización
// ---------------------------------------------------------------------------

model OptimizationRun {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoppingListId String
  shoppingList   ShoppingList     @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  mode           OptimizationMode
  transportMode  TransportMode
  createdAt      DateTime         @default(now())

  plans OptimizationPlan[]

  @@index([userId])
  @@map("optimization_runs")
}

model OptimizationPlan {
  id                      String          @id @default(uuid())
  optimizationRunId       String
  optimizationRun         OptimizationRun @relation(fields: [optimizationRunId], references: [id], onDelete: Cascade)
  rank                    Int
  label                   PlanLabel
  totalProductCost        Decimal         @db.Decimal(12, 2)
  estimatedTravelCost     Decimal         @db.Decimal(12, 2)
  estimatedEffectiveCost  Decimal         @db.Decimal(12, 2)
  additionalDistanceMeters Int
  additionalTimeSeconds    Int
  numberOfStops            Int
  priceConfidence           ConfidenceLevel
  estimatedSavings          Decimal         @db.Decimal(12, 2)
  explanation                String @db.Text

  stops           OptimizationPlanStop[]
  missingProducts OptimizationPlanMissingProduct[]

  @@index([optimizationRunId])
  @@map("optimization_plans")
}

model OptimizationPlanStop {
  id                 String           @id @default(uuid())
  optimizationPlanId String
  optimizationPlan   OptimizationPlan @relation(fields: [optimizationPlanId], references: [id], onDelete: Cascade)
  order              Int
  storeBranchId      String
  storeBranch        StoreBranch      @relation(fields: [storeBranchId], references: [id])

  items OptimizationPlanItem[]

  @@index([optimizationPlanId])
  @@map("optimization_plan_stops")
}

model OptimizationPlanItem {
  id                      String               @id @default(uuid())
  optimizationPlanStopId  String
  optimizationPlanStop    OptimizationPlanStop @relation(fields: [optimizationPlanStopId], references: [id], onDelete: Cascade)
  productVariantId        String
  quantity                Int
  unitPrice                Decimal              @db.Decimal(12, 2)

  @@index([optimizationPlanStopId])
  @@map("optimization_plan_items")
}

/// Producto de la lista que ningún comercio del plan tenía a la venta.
model OptimizationPlanMissingProduct {
  optimizationPlanId String
  optimizationPlan   OptimizationPlan @relation(fields: [optimizationPlanId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([optimizationPlanId, productId])
  @@index([productId])
  @@map("optimization_plan_missing_products")
}
