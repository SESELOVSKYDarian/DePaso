# DePaso Web (la app de Expo exportada para navegador) para EasyPanel.
# Se construye desde la raiz del repo:  docker build -f Dockerfile.web -t depaso-web .
FROM node:22-bookworm-slim AS build

RUN corepack enable
WORKDIR /app

# Primero el codigo (el lockfile necesita ver todos los package.json del workspace).
COPY . .
RUN pnpm install --frozen-lockfile --config.node-linker=hoisted --filter @depaso/mobile...

# URL de la API a la que llama la web. Se puede cambiar con --build-arg (o en EasyPanel).
ARG EXPO_PUBLIC_API_URL=https://estanga-estanga-darian.evo4vr.easypanel.host
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV CI=1 EXPO_NO_TELEMETRY=1

# Exporta la app a archivos estaticos (HTML, JS y assets).
RUN cd apps/mobile && npx expo export -p web --output-dir /app/web-dist

# Segunda etapa: solo nginx con los archivos ya generados.
FROM nginx:1.27-alpine
COPY --from=build /app/web-dist /usr/share/nginx/html
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
