{
  "expo": {
    "name": "DePaso",
    "slug": "depaso",
    "scheme": "depaso",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La usamos para calcular rutas, desvíos y comercios cercanos mientras usás DePaso. No te seguimos fuera de la app."
        }
      ],
      "./plugins/withMonorepoBuildFix.js",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F7",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "DePaso usa el micrófono para que le digas de corrido lo que te falta comprar. El audio se manda para pasarlo a texto y no se guarda."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.com.depaso.mobile"
    },
    "android": {
      "package": "ar.com.depaso.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B0B0C"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "owner": "parahacers-team",
    "extra": {
      "eas": {
        "projectId": "a45d8dda-7b98-47b8-a4bb-49b9f3e4c90b"
      }
    }
  }
}
