    "@depaso/types": "workspace:*",
    "@depaso/validation": "workspace:*",
    "next": "^15.1.3",
    "nodemailer": "^10.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@depaso/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.17",
    "typescript": "^5.7.2",
