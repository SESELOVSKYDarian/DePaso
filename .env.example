# DePaso — variables de entorno de ejemplo. Copiar a .env / .env.local según app.
# No commitear valores reales.

# --- Database (packages/database, apps/api) ---
# MySQL local via docker-compose.yml. En EasyPanel se usa la URL interna del servicio MySQL
# (mysql://usuario:clave@<servicio-mysql>:3306/<base>).
DATABASE_URL="mysql://depaso:depaso@localhost:3306/depaso"

# --- Auth (apps/api) ---
# Secreto para firmar sesiones. Generar uno propio por entorno, nunca reusar este valor.
AUTH_SESSION_SECRET="replace-with-a-long-random-value"

# --- Routing (packages/optimization) ---
# Sin MAPBOX_ACCESS_TOKEN configurado (ver abajo), usa MockRouteProvider (línea recta,
# sin key). Con el token puesto, apps/api usa Mapbox Directions real automáticamente.
MAPS_PROVIDER="mock"

# --- Geocoding, ruteo y mapa visual reales (apps/api, Fase 28 + Fase 17) ---
# Mapbox — 100.000 requests/mes gratis, sin tarjeta de crédito. Un mismo token sirve para
# las tres cosas: geocoding (Fase 28), Directions API para el ruteo real del motor de
# optimización y del mapa (Fase 17), y el mapa visual en sí (Mapbox GL JS, servido al
# cliente vía GET /api/config/mapbox-token — un token "pk.*" está pensado para viajar al
# cliente, no es secreto). Ver docs/development/GEOCODING-SETUP.md para el paso a paso.
# Sin este valor: /api/geocode responde 503, el ruteo cae a MockRouteProvider, y el mapa
# muestra un aviso en vez de romperse.
# MAPBOX_ACCESS_TOKEN="pk.tu-token-real-aca"

# --- Mail (apps/api): recuperar contraseña ---
# SMTP cualquiera (Gmail con "contraseña de aplicación", Brevo, etc.). Sin estas variables
# POST /api/auth/forgot-password responde 503 EMAIL_NOT_CONFIGURED.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"      # "true" para TLS directo (puerto 465)
# SMTP_USER="tu-cuenta@gmail.com"
# SMTP_PASS="contraseña-de-aplicacion"
# SMTP_FROM="DePaso <tu-cuenta@gmail.com>"

# --- Login con redes sociales (apps/api) ---
# Cada proveedor se activa solo si están sus dos valores. En cada consola hay que registrar
# como "redirect URI" exactamente: https://<tu-api>/api/auth/oauth/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# META_APP_ID=""           # también se acepta FACEBOOK_APP_ID
# META_APP_SECRET=""       # también se acepta FACEBOOK_APP_SECRET
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""

# --- Asistente de compras con IA (apps/api) ---
# Cualquier API compatible con OpenAI (/v1/chat/completions). Sin LLM_API_KEY el asistente
# funciona en "modo básico" (corta el texto por comas, sin entender marcas).
# LLM_API_KEY=""
# LLM_BASE_URL="https://llm.enigma-it.com.ar/v1"
# LLM_MODEL="enigma-27b"
# Voz a texto para el botón del micrófono (Groq/OpenAI Whisper). Sin STT_API_KEY el
# micrófono avisa que no está activado y se puede escribir.
# STT_API_KEY=""
# STT_BASE_URL="https://api.groq.com/openai/v1"
# STT_MODEL="whisper-large-v3"

# --- Web (apps/api) ---
# Dominios desde donde se puede abrir la web de la app, separados por coma. Sin esto, la API solo
# acepta pedidos del navegador que vengan de localhost. Ej.: https://mi-web.easypanel.host
# CORS_ALLOWED_ORIGINS=""

# --- Buscador de lugares (apps/api) ---
# Photon (OpenStreetMap). Por defecto usa el servidor público; solo se cambia si se tiene uno propio.
# PHOTON_URL=""

# --- Tareas automáticas (apps/api) ---
# La API corre sola las fotos, las promos y la popularidad. "off" las apaga.
# INTERNAL_CRON=""

# --- Admin (apps/admin) ---
# URL de apps/api que consume el panel admin desde el navegador.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# --- App ---
NODE_ENV="development"

# --- Llamar a mano a las tareas de mantenimiento (apps/api) ---
# Secreto para correr a mano /api/promos/sync, /api/catalog/refresh y /api/catalog/images.
# CRON_SECRET="otro-valor-largo-y-aleatorio"
