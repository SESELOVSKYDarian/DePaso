# DePaso — variables de entorno de ejemplo. Copiar a .env / .env.local según app.
# No commitear valores reales.

# --- Database (packages/database, apps/api) ---
# Postgres local via docker-compose.yml, o instancia gestionada (Supabase/otro).
DATABASE_URL="postgresql://depaso:depaso@localhost:5432/depaso?schema=public"

# --- Auth (apps/api) ---
# Secreto para firmar sesiones. Generar uno propio por entorno, nunca reusar este valor.
AUTH_SESSION_SECRET="replace-with-a-long-random-value"

# --- Routing (packages/optimization) ---
# Sin MAPBOX_ACCESS_TOKEN configurado (ver abajo), usa MockRouteProvider (línea recta,
# sin key). Con el token puesto, apps/api usa Mapbox Directions real automáticamente.
MAPS_PROVIDER="mock"

# --- Geocoding, ruteo y mapa visual reales (apps/api, Fase 28 + Fase 17) ---
# Mapbox — 100.000 requests/mes gratis, sin tarjeta de crédito. Un mismo token sirve para
# las tres cosas: geocoding (Fase 28), Directions API para el ruteo real del motor de
# optimización y del mapa (Fase 17), y el mapa visual en sí (Mapbox GL JS, servido al
# cliente vía GET /api/config/mapbox-token — un token "pk.*" está pensado para viajar al
# cliente, no es secreto). Ver docs/development/GEOCODING-SETUP.md para el paso a paso.
# Sin este valor: /api/geocode responde 503, el ruteo cae a MockRouteProvider, y el mapa
# muestra un aviso en vez de romperse.
# MAPBOX_ACCESS_TOKEN="pk.tu-token-real-aca"

# --- Admin (apps/admin) ---
# URL de apps/api que consume el panel admin desde el navegador.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# --- App ---
NODE_ENV="development"
